# ─── Cliente (Vite) — SOMENTE valores públicos. Nenhuma chave de serviço aqui. ───
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key-publica>
# Caminho de publicação: meta (padrão) ou mixpost
VITE_PUBLISH_PROVIDER=meta

# ─── Edge Functions (Supabase secrets) — NUNCA no bundle do cliente ───
# Defina via: supabase secrets set NOME=valor
#   ANTHROPIC_API_KEY         chave da Anthropic Messages API (geração por IA, §7)
#   SUPABASE_SERVICE_ROLE_KEY usada pelas functions server-side (cron)
#
#   Publicação PADRÃO via Meta Graph API (grátis; conta própria, modo dev — ver
#   docs/meta-setup.md):
#   IG_USER_ID                id da conta Instagram profissional (Business/Creator)
#   META_LONG_LIVED_TOKEN     token de longa duração (renovado por job diário)
#   META_APP_ID / META_APP_SECRET
#
#   (Alternativa) Publicação via Mixpost — só se VITE_PUBLISH_PROVIDER=mixpost:
#   MIXPOST_BASE_URL / MIXPOST_CORE_PATH / MIXPOST_WORKSPACE_UUID
#   MIXPOST_TOKEN / MIXPOST_ACCOUNT_ID   (ver docs/mixpost-setup.md — exige Mixpost Pro)
#
# ─── Vault (usado pelo pg_cron, §2) ───
# A service_role key usada pelo cron fica no Supabase Vault, nunca em texto plano
# na definição do job. Ver supabase/migrations/0004_cron.sql.
