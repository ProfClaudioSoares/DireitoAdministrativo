# ─── Cliente (Vite) — SOMENTE valores públicos. Nenhuma chave de serviço aqui. ───
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key-publica>

# ─── Edge Functions (Supabase secrets) — NUNCA no bundle do cliente ───
# Defina via: supabase secrets set NOME=valor
#   ANTHROPIC_API_KEY        chave da Anthropic Messages API (§7)
#   SUPABASE_SERVICE_ROLE_KEY usada pelas functions server-side
#   IG_USER_ID               id da conta Instagram profissional
#   META_APP_ID / META_APP_SECRET
#   META_LONG_LIVED_TOKEN    token de longa duração (renovado por job diário, §10)
#
# ─── Vault (usado pelo pg_cron, §2 / §10) ───
# A service_role key usada pelo cron fica no Supabase Vault, nunca em texto plano
# na definição do job. Ver supabase/migrations/0002_cron.sql.
