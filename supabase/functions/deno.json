{
  "//": "Import map das Edge Functions. O alias @/ aponta para src/ do app para que os módulos ÚNICOS (templates, measure, schema) sejam importados sem duplicação (§3). React e satori resolvem via esm.sh.",
  "imports": {
    "@/": "../../src/",
    "react": "https://esm.sh/react@18.3.1",
    "react/jsx-runtime": "https://esm.sh/react@18.3.1/jsx-runtime",
    "zod": "https://esm.sh/zod@3.23.8",
    "opentype.js": "https://esm.sh/opentype.js@1.3.4",
    "satori": "https://esm.sh/satori@0.10.13",
    "@resvg/resvg-wasm": "https://esm.sh/@resvg/resvg-wasm@2.6.2",
    "@supabase/supabase-js": "https://esm.sh/@supabase/supabase-js@2.45.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
